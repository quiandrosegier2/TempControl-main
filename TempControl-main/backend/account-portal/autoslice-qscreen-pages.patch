+<!doctype html>
+<html lang="nl">
+<head>
+  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+  <meta name="referrer" content="no-referrer">
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; connect-src https://ybmesonqfclarqigwxfe.supabase.co; base-uri 'none'; form-action 'none'">
+  <title>Qscreen — Account bevestigen</title>
+  <link rel="stylesheet" href="./style.css"><script src="./config.js" defer></script><script src="./app.js" defer></script>
+</head>
+<body>
+  <main class="card">
+    <span class="brand">Qscreen <b>//</b></span><p class="eyebrow">QPRINTS ACCOUNT</p>
+    <h1 id="title">Je account controleren.</h1>
+    <p id="status" role="status" aria-live="polite">Even wachten…</p>
+    <form id="password-form" hidden>
+      <label for="password">Nieuw wachtwoord</label><input id="password" type="password" autocomplete="new-password" minlength="12" maxlength="256" required>
+      <label for="confirmation">Herhaal je wachtwoord</label><input id="confirmation" type="password" autocomplete="new-password" minlength="12" maxlength="256" required>
+      <button type="submit" id="save">Wachtwoord bewaren</button>
+    </form>
+    <p class="foot">Je ontwerpen en sensormetingen worden hier niet geüpload.<br>Deze pagina hoort bij Qscreen, afzonderlijk van je AutoSlice-account.</p>
+  </main>
+</body>
+</html>
